{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "shared": {
      "projectType": "library",
      "schematics": {},
      "root": "packages/shared",
      "sourceRoot": "packages/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "packages/shared/tsconfig.json",
            "project": "packages/shared/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "packages/shared/tsconfig.json"
            },
            "development": {
              "tsConfig": "packages/shared/tsconfig.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "packages/shared/tsconfig.spec.json",
            "inlineStyleLanguage": "less",
            "karmaConfig": "karma.conf.js"
          }
        }
      }
    },
    "plugin.reminder": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less"
        }
      },
      "root": "packages/reminder",
      "sourceRoot": "packages/reminder/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@c8y/devkit:build",
          "options": {
            "outputPath": "dist/cumulocity-reminder-plugin",
            "main": "packages/reminder/src/main.ts",
            "tsConfig": "packages/reminder/tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "packages/reminder/public"
              }
            ],
            "inlineStyleLanguage": "less",
            "scripts": [],
            "aot": false,
            "buildOptimizer": false,
            "allowedCommonJsDependencies": [
              "regenerator-runtime/runtime",
              "@cordobo/qrcode",
              "zone.js/dist/zone",
              "chroma-js",
              "lodash"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "buildOptimizer": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@c8y/devkit:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "plugin.reminder:build:production"
            },
            "development": {
              "buildTarget": "plugin.reminder:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 9001,
            "publicHost": "localhost:9001"
          }
        },
        "deploy": {
          "builder": "@c8y/devkit:deploy",
          "configurations": {
            "production": {
              "buildTarget": "plugin.reminder:build:production"
            },
            "development": {
              "buildTarget": "plugin.reminder:build:development"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "packages/reminder/tsconfig.spec.json",
            "inlineStyleLanguage": "less",
            "karmaConfig": "karma.conf.js"
          }
        }
      }
    },
