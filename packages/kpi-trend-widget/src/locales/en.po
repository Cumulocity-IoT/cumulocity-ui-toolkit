msgid "kpi-trend.config.layout-help"
msgstr "Choose how the gauge and the trend are arranged on the card."

msgid "kpi-trend.config.icon-help"
msgstr "Shown next to the label in the widget header."

msgid "kpi-trend.config.color-help"
msgstr "Used for both the gauge arc and the sparkline. Starts with the data point's color; pick another color to override it, or select Reset to return to the data point's color."

msgid "kpi-trend.config.window-help"
msgstr "The period the sparkline and the trend percentage cover, ending at the latest measurement. The trend percentage compares the average at the start of this period with the average at its end."

msgid "kpi-trend.config.points-help"
msgstr "The number of points the sparkline draws across the trend window, from 2 to 40. Each point is the average of the measurements in its part of the window."

msgid "kpi-trend.config.min-help"
msgstr "Lower end of the gauge's fill range. Leave blank to use the data point's minimum, or 0 if it has none."

msgid "kpi-trend.config.max-help"
msgstr "Upper end of the gauge's fill range. Leave blank to use the data point's maximum. Without a maximum, the gauge is hidden."

msgid "kpi-trend.config.direction-help"
msgstr "Uncheck for KPIs where a lower value is better, for example temperature or vibration."

msgid "kpi-trend.steady"
msgstr "steady"

msgid "kpi-trend.aria-trend-up"
msgstr "up {{delta}} percent over {{window}}"

msgid "kpi-trend.aria-trend-down"
msgstr "down {{delta}} percent over {{window}}"

msgid "From KPI"
msgstr "From KPI"

msgid "Displays a single measurement value with a radial gauge (value vs. max) and a trend sparkline. Configurable as a radial primary or compact tile layout."
msgstr "Displays a single measurement value with a radial gauge (value vs. max) and a trend sparkline. Configurable as a radial primary or compact tile layout."
