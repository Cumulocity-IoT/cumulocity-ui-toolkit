# Hoist all packages to root node_modules (required for Angular tooling + Cumulocity devkit)
shamefully-hoist=true

# Workspace settings
link-workspace-packages=true
prefer-workspace-packages=true
shared-workspace-lockfile=true

# Automatically install missing peer dependencies
auto-install-peers=true

# Ensure peer dependencies are not auto-installed in unexpected ways
strict-peer-dependencies=true

# Prevent lifecycle scripts from untrusted packages
ignore-scripts=true
