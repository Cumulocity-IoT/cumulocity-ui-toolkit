    "lint:fix": "eslint . --quiet --fix",
    "--pre/post-----------": "--------------------",
    "prebuild": "pnpm run clean",
    "--tools--------------": "--------------------",
    "generate:scripts": "node --experimental-strip-types tools/generate-scripts.mts",
