    "e2e:run:layered-map-widget": "pnpm -C test exec -- cypress run --browser chromium --config-file config/layered-map-widget.config.ts",
    "e2e:run:index-db-cache": "pnpm -C test exec -- cypress run --browser chromium --config-file config/index-db-cache.config.ts",
