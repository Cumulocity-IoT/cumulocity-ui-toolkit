    "test:operations-widget": "ng test plugin.operations-widget --watch=false --browsers=ChromeHeadlessCI",
    "test:watch:operations-widget": "ng test plugin.operations-widget --browsers=ChromeHeadless",
    "test:release-notes": "ng test plugin.release-notes --watch=false --browsers=ChromeHeadlessCI",
    "test:watch:release-notes": "ng test plugin.release-notes --browsers=ChromeHeadless",
    "test:reminder": "ng test plugin.reminder --watch=false --browsers=ChromeHeadlessCI",
    "test:watch:reminder": "ng test plugin.reminder --browsers=ChromeHeadless",
    "test:smart-views": "ng test plugin.smart-views --watch=false --browsers=ChromeHeadlessCI",
